# Settings for the throwaway stack the browser tests run against (see run-e2e.sh).
# Used instead of the real .env, so no real password or AI key is read.
# Other ports than the normal stack, so both can run at the same time.
POSTGRES_PASSWORD=e2e-only-password
POSTGRES_HOST_PORT=5436
API_HOST_PORT=8002
WEB_HOST_PORT=8082
WEB_API_URL=http://127.0.0.1:8002
CORS_ORIGINS=http://127.0.0.1:8082
# No AI key: the copilot must explain that it is not set up.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
