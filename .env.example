# Copy to .env and fill in values. Never commit .env.
# Used both by docker compose and by the API when run directly on your machine.

ENVIRONMENT=local
LOG_LEVEL=INFO
# json = one JSON object per line (containers/cloud); text = easier to read locally
LOG_FORMAT=json

# How long a login token stays valid, in minutes (default 480 = 8 hours).
ACCESS_TOKEN_TTL_MINUTES=480

# Proxies allowed to report the real client IP (X-Forwarded-For). Used by login rate
# limiting. Never use "*" on a server reachable directly from the internet: anyone
# could then fake their IP. In AWS set this to the load balancer subnet, e.g. 10.0.0.0/16.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# PostgreSQL connection. Passwords may contain URL-reserved characters such as @ : / #
# because the API builds its database URL with SQLAlchemy's URL.create().
# Avoid "$" in the password: docker compose treats it as variable interpolation.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chainpilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=chainpilot

# Host ports published by docker compose. Keep the bind addresses at 127.0.0.1
# unless you deliberately want other machines on your network to reach them.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8080
# The API address the browser uses (built into the web container). If you change
# API_HOST_PORT or WEB_HOST_PORT, change WEB_API_URL and CORS_ORIGINS to match.
WEB_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- AI copilot (P5-T3): Groq or Google Gemini --------------------------------
# Which provider the copilot uses: groq or gemini.
LLM_PROVIDER=groq
# Paste your own keys after the = sign. Keep them only in .env (ignored by Git).
# Groq: console.groq.com -> API Keys. Model ids: console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=
# Gemini: aistudio.google.com -> Get API key. Model ids: ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=
