# Secrets and local configuration
.env
.env.*
!.env.example
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Kaggle API credentials and downloaded dataset archives must never be committed.
kaggle.json
*.zip

# Data and models: raw/generated data and trained artifacts stay out of Git.
data/raw/
data/processed/
data/synthetic/
*.parquet
*.joblib
*.pkl
# Trained model files (rebuild with: python -m demand_forecasting.train_final)
ml/artifacts/
mlruns/

# Node / frontend (apps/web)
node_modules/
.next/
apps/web/dist/
apps/web/test-results/
apps/web/playwright-report/
*.tsbuildinfo

# Terraform: state, plugins, the filled-in backend file and variable files (may hold emails)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
backend.hcl
*.tfvars

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
